# Copy to ~/.config/linux-workload-guard/workload-guard.env
# and load it from workload-router.service if you want host-specific policy.

WORKLOAD_GUARD_PARENT_UNIT=protected-workload.slice
WORKLOAD_GUARD_HEAVY_UNIT=heavy-workload.slice
WORKLOAD_GUARD_SAMPLE_SEC=2
WORKLOAD_GUARD_SUSTAINED_SAMPLES=4
WORKLOAD_GUARD_CPU_THRESHOLD=70
WORKLOAD_GUARD_MAX_ANCESTRY=32

# Comma-separated command-line fragments to ignore.
# WORKLOAD_GUARD_EXCLUDE_PATTERNS=chromedriver,python-my-worker

# Optional browser automation integration.
# WORKLOAD_GUARD_BROWSER_PROCESS_PATTERN=google-chrome-chatgpt
