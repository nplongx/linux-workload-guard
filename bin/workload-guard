#!/bin/sh
set -eu

usage() {
  cat <<'USAGE'
Linux Workload Guard

Usage:
  workload-guard status    Show services, quotas, and routed workloads
  workload-guard diagnose  Show configuration and cgroup paths
  workload-guard stats      Show adaptive workload statistics
  workload-guard quota      Show current quota-controller telemetry
  workload-guard history    Summarize recent runtime health (1h/6h/24h)
  workload-guard profile    Profile cgroups, CPU PSI, and scheduler latency
  workload-guard protect <command...>
  workload-guard version   Show version
  workload-guard help      Show this help
USAGE
}

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd)
VERSION_FILE="$ROOT/VERSION"
if [ ! -f "$VERSION_FILE" ]; then VERSION_FILE="$HOME/.local/share/linux-workload-guard/VERSION"; fi
if [ ! -f "$VERSION_FILE" ]; then VERSION_FILE=""; fi
version() {
  if [ -n "$VERSION_FILE" ]; then cat "$VERSION_FILE"; else printf '%s\n' unknown; fi
}
show_unit() {
  unit=$1
  printf '\n[%s]\n' "$unit"
  systemctl --user show "$unit" \
    -p ActiveState -p SubState -p ControlGroup -p CPUQuotaPerSecUSec -p CPUWeight \
    --no-pager 2>/dev/null || true
}
show_routes() {
  state_file="${WORKLOAD_GUARD_STATE_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/linux-workload-guard/routes.tsv}"
  printf '\n[Routed workloads]\n'
  if [ ! -s "$state_file" ]; then
    printf '%s\n' 'none'
    return
  fi
  printf '%-7s %-7s %-16s %-34s %-34s %s\n' PID CPU REASON SOURCE DESTINATION COMMAND
  while IFS="$(printf '\t')" read -r pid cpu reason source target cmd; do
    [ -n "$pid" ] || continue
    current_cpu=$(ps -p "$pid" -o %cpu= 2>/dev/null | awk '{print $1}' || true)
    [ -n "$current_cpu" ] || current_cpu="$cpu"
    printf '%-7s %-7s %-16s %-34s %-34s %s\n' "$pid" "${current_cpu}%" "$reason" "$source" "$target" "$cmd"
  done < "$state_file"
}
show_quota() {
  unit="${WORKLOAD_GUARD_HEAVY_UNIT:-heavy-workload.slice}"
  printf '\n[Quota controller]\n'
  systemctl --user show "$unit" -p CPUQuotaPerSecUSec -p CPUWeight --no-pager 2>/dev/null || true
  if [ -r /proc/pressure/cpu ]; then
    awk '/^some / {print "CPU PSI some: " $2 " " $3 " " $4 " " $5 " " $6}' /proc/pressure/cpu
  fi
  cgroup=$(systemctl --user show "$unit" -p ControlGroup --value 2>/dev/null || true)
  if [ -n "$cgroup" ] && [ -r "/sys/fs/cgroup$cgroup/cpu.stat" ]; then
    awk '$1=="nr_periods" || $1=="nr_throttled" {printf "%s: %s\n", $1, $2}' "/sys/fs/cgroup$cgroup/cpu.stat"
  fi
  printf 'scheduler thresholds: high=%sms low=%sms\n' "${WORKLOAD_GUARD_QUOTA_SCHED_DELAY_HIGH_MS:-20}" "${WORKLOAD_GUARD_QUOTA_SCHED_DELAY_LOW_MS:-5}"
  printf 'PSI thresholds: high=%s low=%s\n' "${WORKLOAD_GUARD_QUOTA_PRESSURE_HIGH:-0.40}" "${WORKLOAD_GUARD_QUOTA_PRESSURE_LOW:-0.10}"
}
show_history() {
  state_file="${WORKLOAD_GUARD_HISTORY_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/linux-workload-guard/history.jsonl}"
  printf '\n[Runtime history]\n'
  if [ ! -s "$state_file" ]; then printf '%s\n' 'none'; return; fi
  python3 - "$state_file" <<'PY'
import json,sys,time,statistics
path=sys.argv[1]; now=time.time(); rows=[]
try:
    with open(path) as f:
        for line in f:
            try:
                x=json.loads(line)
                if now-float(x.get('ts',0)) <= 86400: rows.append(x)
            except Exception: pass
except Exception: print('unavailable'); raise SystemExit
if not rows: print('no samples in last 24h'); raise SystemExit
def report(label,age):
    rs=[x for x in rows if now-float(x.get('ts',0)) <= age]
    if not rs: print(f'\n{label}: no samples'); return
    def vals(k): return [float(x[k]) for x in rs if x.get(k) is not None]
    v2=[x for x in rs if int(x.get('schema_version',1)) >= 2]
    q=vals('quota'); p=vals('cpu_psi_some_avg10'); s=[float(x['scheduler_delay_ms']) for x in v2 if x.get('scheduler_delay_ms') is not None]; u=vals('heavy_cpu_pct'); t=vals('heavy_throttle_ratio')
    print(f'\n{label} ({len(rs)} samples)')
    print(f'  routed now       : {rs[-1].get("routed",0)}')
    def counter_delta(key):
        total=0; prev=None
        for x in rs:
            cur=int(x.get(key,0))
            if prev is not None: total += cur-prev if cur >= prev else cur
            prev=cur
        return total
    print(f'  route events     : {counter_delta("route_events")}')
    print(f'  recovery events  : {counter_delta("recovery_events")}')
    print(f'  quota changes    : {counter_delta("quota_changes")}')
    if q: print(f'  quota avg/range  : {statistics.mean(q):.0f}% ({min(q):.0f}-{max(q):.0f}%)')
    if u: print(f'  heavy CPU avg    : {statistics.mean(u):.1f}%')
    if t: print(f'  heavy throttle   : {statistics.mean(t)*100:.1f}%')
    if p: print(f'  CPU PSI avg10    : {statistics.mean(p)*100:.1f}% (peak {max(p)*100:.1f}%)')
    if s:
        p95=statistics.quantiles(s,n=20)[18] if len(s)>=2 else s[0]
        print(f'  scheduler delay  : avg {statistics.mean(s):.1f}ms, p95 {p95:.1f}ms, peak {max(s):.1f}ms')
    g=vals('guarded_cpu_pct'); m=vals('unmanaged_cpu_pct')
    if g: print(f'  guarded CPU avg  : {statistics.mean(g):.1f}%')
    if m: print(f'  unmanaged CPU avg : {statistics.mean(m):.1f}%')
for label,age in [('Last 1h',3600),('Last 6h',21600),('Last 24h',86400)]: report(label,age)
print(f'\n  latest sample    : {time.strftime("%Y-%m-%d %H:%M:%S %z", time.localtime(rows[-1]["ts"]))}')
PY
}
show_diagnose() {
  state_file="${WORKLOAD_GUARD_HISTORY_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/linux-workload-guard/history.jsonl}"
  printf '\n[System diagnosis]\n'
  python3 - "$state_file" "${WORKLOAD_GUARD_QUOTA_PRESSURE_HIGH:-0.40}" "${WORKLOAD_GUARD_QUOTA_SCHED_DELAY_HIGH_MS:-20}" <<'PY'
import json, os, sys, time, statistics
path=sys.argv[1]; psi_high=float(sys.argv[2]); sched_high=float(sys.argv[3]); now=time.time()
rows=[]
try:
    with open(path) as f:
        for line in f:
            try:
                x=json.loads(line)
                if int(x.get('schema_version',1)) >= 2 and now-float(x.get('ts',0)) <= 3600: rows.append(x)
            except Exception: pass
except OSError: pass
if not rows:
    print('  no schema-v2 samples in last 1h'); raise SystemExit
latest=rows[-1]
psi=[float(x['cpu_psi_some_avg10']) for x in rows if x.get('cpu_psi_some_avg10') is not None]
sched=[float(x['scheduler_delay_ms']) for x in rows if x.get('scheduler_delay_ms') is not None]
guard=[float(x['guarded_cpu_pct']) for x in rows if x.get('guarded_cpu_pct') is not None]
unmanaged=[float(x['unmanaged_cpu_pct']) for x in rows if x.get('unmanaged_cpu_pct') is not None]
cpu_capacity=max(1, os.cpu_count() or 1) * 100.0
g=statistics.mean(guard) if guard else 0.0; u=statistics.mean(unmanaged) if unmanaged else 0.0
pressure_high=max(psi, default=0.0) >= psi_high
scheduler_high=(statistics.mean(sched) >= sched_high if sched else False) or (max(sched, default=0.0) >= sched_high)
g_share=g / cpu_capacity; u_share=u / cpu_capacity
guarded_high=g_share >= 0.25 and g > u
unmanaged_high=u_share >= 0.25 and u > g
print(f'  samples            : {len(rows)}')
print(f'  CPU pressure       : {"HIGH" if pressure_high else "NORMAL"} (PSI peak {max(psi, default=0)*100:.1f}%)')
print(f'  Scheduler delay    : {"HIGH" if scheduler_high else "NORMAL"} (latest {float(latest.get("scheduler_delay_ms") or 0):.1f} ms)')
print(f'  Guarded CPU        : {g:.1f}% avg')
print(f'  Unmanaged CPU      : {u:.1f}% avg')
if guarded_high and pressure_high:
    source='guarded workload pressure'
elif unmanaged_high and pressure_high:
    source='unmanaged CPU pressure'
elif pressure_high:
    source='general system pressure (top process CPU does not explain PSI)'
else:
    source='no high CPU-pressure condition recorded'
print(f'  Observed source    : {source}')
routes=int(latest.get('routed',0) or 0)
print(f'  Guard action       : {"routing active" if routes else "no routed workload"}')
print('  Top consumers:')
for item in latest.get('top_cpu',[])[:5]:
    print(f'    {item.get("command","[unknown]")[:34]:34s} {float(item.get("cpu_pct",0)):6.1f}% {item.get("class","unknown")}')
PY
}
show_stats() {
  state_file="${WORKLOAD_GUARD_STATS_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/linux-workload-guard/stats.json}"
  printf '\n[Adaptive statistics]\n'
  if [ ! -s "$state_file" ]; then printf '%s\n' 'none'; return; fi
  python3 - "$state_file" <<'PY'
import json, sys
try: data=json.load(open(sys.argv[1]))
except Exception: print("unavailable"); raise SystemExit
print("%-28s %-8s %-10s %-10s" % ("CLASS","SAMPLES","MEAN_CPU","VARIANCE"))
for cls, item in sorted(data.items()):
    print("%-28s %-8s %-10.1f %-10.1f" % (cls, item.get("samples",0), item.get("mean",0), item.get("variance",0)))
PY
}
protect() {
  if [ "$#" -eq 0 ]; then usage >&2; exit 2; fi
  exec systemd-run --user --scope --slice=protected-workload.slice -- "$@"
}
case "${1:-status}" in
  status)
    printf 'Linux Workload Guard %s\n' "$(version)"
    show_unit protected-workload.slice
    show_unit heavy-workload.slice
    show_unit workload-router.service
    show_unit browser-automation.slice
    show_routes
    ;;
  diagnose)
    printf 'Linux Workload Guard %s\n' "$(version)"
    show_diagnose
    ;;
  stats)
    show_stats
    ;;
  quota)
    show_quota
    ;;
  history)
    show_history
    ;;
  profile)
    shift
    exec "$ROOT/bin/workload-profile" "$@"
    ;;
  protect)
    shift
    protect "$@"
    ;;
  version|-V|--version) version ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
